Algoritmo sin_titulo	
	
	Dimension valores(10)
	
	Para  B = 1 Hasta 10 Con Paso 1 Hacer
		Escribir "Ingresar valor de ", "[" ,B, "]"
		leer A
		valores[B] = A
	FinPara
	
	Limpiar Pantalla
	
	Para Contar = 1 Hasta 10 Con Paso 1 Hacer
		Escribir "Valor ingresado en ", "[" ,Contar, "]: ", valores[Contar]
	FinPara
	
FinAlgoritmo