Algoritmo sin_titulo// programa que lea un valor numerico,calcule la potencia y muestre el resultado
	Definir num Como Entero
	Definir potencia Como Entero
	
	Escribir "ingrese un numero: "
	leer num
	
	Escribir "ingrese el valor de la potencia: "
	leer potencia
	
	Escribir "El resultado de la potencia es: ",num^potencia
	
FinAlgoritmo
